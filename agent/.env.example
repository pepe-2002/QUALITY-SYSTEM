# ————————————————————————————————————————————————————————————————
# ARA — configuration. Copiez ce fichier en `.env` et adaptez.
# `.env` n'est JAMAIS versionné : c'est le seul endroit où mettre une clé.
# Aucune valeur réelle ne doit apparaître dans ce fichier d'exemple.
# ————————————————————————————————————————————————————————————————

# --- Modèle de langage ---------------------------------------------------
# offline        : moteur extractif intégré, gratuit, aucune clé (défaut)
# ollama         : modèle local gratuit (https://ollama.com)
# openai_compat  : tout service exposant /v1/chat/completions
# anthropic      : API Claude
ARA_LLM_PROVIDER=offline

# Ollama (local, gratuit)
# ARA_OLLAMA_URL=http://127.0.0.1:11434
# ARA_OLLAMA_MODEL=llama3.2

# Services distants — la clé se met ICI, jamais dans le code.
# ARA_OPENAI_BASE_URL=
# ARA_OPENAI_MODEL=
# ARA_OPENAI_API_KEY=
# ARA_ANTHROPIC_MODEL=
# ARA_ANTHROPIC_API_KEY=

# --- Recherche web -------------------------------------------------------
# auto (défaut) : DuckDuckGo + Wikipédia, sans clé
# duckduckgo | wikipedia | searxng | fixture
ARA_SEARCH_PROVIDER=auto
ARA_WIKIPEDIA_LANG=fr
# ARA_SEARXNG_URL=
# Pause entre deux recherches, en secondes (évite les réponses 429).
ARA_SEARCH_DELAY=1

# --- Budgets d'arrêt -----------------------------------------------------
ARA_MAX_RESEARCH_STEPS=10
ARA_MAX_TASK_SECONDS=300
ARA_MAX_DESIGN_ITERATIONS=5
ARA_DESIGN_TARGET_SCORE=85

# --- Stockage ------------------------------------------------------------
# ARA_WORKSPACE=/chemin/vers/workspace

# --- Sécurité ------------------------------------------------------------
# Liste blanche des outils. Un outil absent est refusé même s'il existe.
# ARA_ALLOWED_TOOLS=web_search,fetch_page,extract_text,save_file,list_files,read_file,create_pdf,create_docx,create_markdown,create_txt
# Outils exigeant une confirmation humaine avant exécution.
# ARA_SENSITIVE_TOOLS=delete_file,publish,send_message,purchase
ARA_REQUIRE_APPROVAL=1
# Jeton d'accès à l'API. Vivement conseillé hors réseau domestique.
# ARA_TOKEN=

# --- Serveur -------------------------------------------------------------
ARA_HOST=0.0.0.0
ARA_PORT=8800
