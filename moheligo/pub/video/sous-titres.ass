Dialogue: 0,0:00:00.20,0:00:02.80,ST,,0,0,0,,VOUS QUI NOUS REGARDEZ\NAUX QUATRE COINS DU MONDE
Dialogue: 0,0:00:02.80,0:00:05.18,ST,,0,0,0,,QUE LA PAIX SOIT AVEC VOUS.
Dialogue: 0,0:00:05.30,0:00:08.30,ST,,0,0,0,,JE SUIS DEVANT VOUS AUJOURD'HUI\NAVEC JOIE
Dialogue: 0,0:00:08.30,0:00:10.80,ST,,0,0,0,,POUR VOUS PROPOSER\NUNE APPLICATION
Dialogue: 0,0:00:10.90,0:00:13.40,ST,,0,0,0,,QUI FACILITE\NNOS VOYAGES MARITIMES
Dialogue: 0,0:00:13.50,0:00:15.30,ST,,0,0,0,,ENTRE MOHÉLI ET NGAZIDJA
Dialogue: 0,0:00:15.40,0:00:17.36,ST,,0,0,0,,SANS QUE VOUS AYEZ\NÀ VOUS RENDRE AU PORT
Dialogue: 0,0:00:17.78,0:00:19.48,ST,,0,0,0,,ET CETTE APPLICATION\NN'EST RIEN D'AUTRE QUE :
Dialogue: 0,0:00:19.58,0:00:20.88,ST,,0,0,0,,{\c&H16CDFA&\fs54}MoheliGo
Dialogue: 0,0:00:21.08,0:00:25.48,ST,,0,0,0,,DONC JE VOUS INVITE\NÀ VOUS ABONNER
Dialogue: 0,0:00:25.58,0:00:31.28,ST,,0,0,0,,ET CLIQUEZ SUR LE LIEN\NPOUR PLUS D'INFOS.
Dialogue: 0,0:00:31.38,0:00:33.60,ST,,0,0,0,,AVEC {\c&H16CDFA&}MoheliGo{\c&HFFFFFF&},\NC'EST LA MER QUI DÉCIDE,
Dialogue: 0,0:00:33.73,0:00:35.41,ST,,0,0,0,,NOUS, ON TE LE DIT AVANT !
